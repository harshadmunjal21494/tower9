<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
<Id>9f7c2a61-5f35-4f8d-9d7e-2a4c9b6e8132</Id>
<Version>1.0.0.0</Version>
<ProviderName>Tower 9</ProviderName>
<DefaultLocale>en-US</DefaultLocale>
<DisplayName DefaultValue="Tower 9 Sale Alert"/>
<Description DefaultValue="Checks Tower 9 inventory when the workbook opens."/>
<IconUrl DefaultValue="https://harshadmunjal21494.github.io/tower9/icon-32.png"/>
<HighResolutionIconUrl DefaultValue="https://harshadmunjal21494.github.io/tower9/icon-80.png"/>
<SupportUrl DefaultValue="https://harshadmunjal21494.github.io/tower9/"/>
<AppDomains>
<AppDomain>https://harshadmunjal21494.github.io</AppDomain>
</AppDomains>
<Hosts>
<Host Name="Workbook"/>
</Hosts>
<Requirements>
<Sets DefaultMinVersion="1.1">
<Set Name="SharedRuntime" MinVersion="1.1"/>
</Sets>
</Requirements>
<DefaultSettings>
<SourceLocation DefaultValue="https://harshadmunjal21494.github.io/tower9/taskpane.html"/>
</DefaultSettings>
<Permissions>ReadWriteDocument</Permissions>
<VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
<Hosts>
<Host xsi:type="Workbook">
<Runtimes>
<Runtime resid="Taskpane.Url" lifetime="long"/>
</Runtimes>
<DesktopFormFactor>
<GetStarted>
<Title resid="GetStarted.Title"/>
<Description resid="GetStarted.Description"/>
<LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
</GetStarted>
<FunctionFile resid="Taskpane.Url"/>
<ExtensionPoint xsi:type="PrimaryCommandSurface">
<OfficeTab id="TabHome">
<Group id="Tower9Group">
<Label resid="Group.Label"/>
<Icon>
<bt:Image size="16" resid="Icon16"/>
<bt:Image size="32" resid="Icon32"/>
<bt:Image size="80" resid="Icon80"/>
</Icon>
<Control xsi:type="Button" id="Tower9Button">
<Label resid="Button.Label"/>
<Supertip>
<Title resid="Button.Label"/>
<Description resid="Button.Tooltip"/>
</Supertip>
<Icon>
<bt:Image size="16" resid="Icon16"/>
<bt:Image size="32" resid="Icon32"/>
<bt:Image size="80" resid="Icon80"/>
</Icon>
<Action xsi:type="ShowTaskpane">
<TaskpaneId>Tower9TaskPane</TaskpaneId>
<SourceLocation resid="Taskpane.Url"/>
</Action>
</Control>
</Group>
</OfficeTab>
</ExtensionPoint>
</DesktopFormFactor>
</Host>
</Hosts>
<Resources>
<bt:Images>
<bt:Image id="Icon16" DefaultValue="https://harshadmunjal21494.github.io/tower9/icon-16.png"/>
<bt:Image id="Icon32" DefaultValue="https://harshadmunjal21494.github.io/tower9/icon-32.png"/>
<bt:Image id="Icon80" DefaultValue="https://harshadmunjal21494.github.io/tower9/icon-80.png"/>
</bt:Images>
<bt:Urls>
<bt:Url id="Taskpane.Url" DefaultValue="https://harshadmunjal21494.github.io/tower9/taskpane.html"/>
<bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://harshadmunjal21494.github.io/tower9/"/>
</bt:Urls>
<bt:ShortStrings>
<bt:String id="GetStarted.Title" DefaultValue="Tower 9 Sale Alert"/>
<bt:String id="Group.Label" DefaultValue="Tower 9"/>
<bt:String id="Button.Label" DefaultValue="Tower 9 Sale Alert"/>
</bt:ShortStrings>
<bt:LongStrings>
<bt:String id="GetStarted.Description" DefaultValue="Checks Tower 9 availability when this workbook opens."/>
<bt:String id="Button.Tooltip" DefaultValue="Show the Tower 9 sale alert."/>
</bt:LongStrings>
</Resources>
</VersionOverrides>
</OfficeApp>
